[Unit]
Description=Hermes Agent Teams Rust Sidecar Daemon (hermes-teamsd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
Environment=HERMES_HOME=/root/.hermes
Environment=HERMES_TEAMS_HOST=127.0.0.1
Environment=HERMES_TEAMS_PORT=17890
Environment=HERMES_TEAMS_AUTH_MODE=legacy
Environment=HERMES_TEAMS_DEFAULT_WORKSPACE=/root
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/hermes-teamsd
Restart=always
RestartSec=3
MemoryMax=128M
CPUQuota=100%
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-teamsd

[Install]
WantedBy=multi-user.target
